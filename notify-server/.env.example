# Copy to .env.local for local testing with `vercel dev`.
# In production these are set with `vercel env add` (see README.md) —
# never commit the real values.

# The full service account JSON as ONE line, e.g.:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"spidertack",...}
FIREBASE_SERVICE_ACCOUNT=

# Any random string you generate yourself, e.g. `openssl rand -hex 32`
NOTIFY_SECRET=

# --- Backblaze B2 (pin photo uploads) ---
# From the B2 bucket page's "Endpoint" field, e.g. s3.us-west-004.backblazeb2.com
B2_ENDPOINT=
# The middle segment of the endpoint above, e.g. us-west-004
B2_REGION=
B2_BUCKET=
# From Application Keys → Add a New Application Key
B2_KEY_ID=
B2_APPLICATION_KEY=
